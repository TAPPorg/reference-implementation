# Run file for the CCD example: which backends and executors exist, and which executor runs which term in what order.
# Lines starting with # and empty lines are ignored.

# backend <name> <path to the shared library of the TAPP implementation>
# Relative paths are relative to the directory the example is run from.
backend tblis build/tblis/libtapp-tblis.so
# The cuda implementation is not in this branch and not finished: the path is a placeholder
#backend cuda  build/cuda/libtapp-cuda.so

# executor <name> <backend> [<attribute>=<value> ...]
# The attributes are specific to the backend. For tblis:
#   cpus=<list>    CPUs the threads of the executor run on: numbers and ranges separated by commas, in any combination
#   threads=<n>    number of threads, default one per CPU of cpus
executor e0 tblis cpus=0
# The CPUs do not have to be next to each other: this executor gets 1, 3, 6, 7 and 12
executor e1 tblis cpus=1,3,6-7,12
#executor g0 cuda

# run <term or range of terms> <executor>
# The terms are submitted in the order of the lines, and every term has to be listed exactly once. A term that reads a
# tensor has to come after the terms that write it.
run c1-c31 e0
